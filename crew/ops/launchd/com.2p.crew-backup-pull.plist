<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Mac mini: pulls the crew-v3-spike VPS backups daily at 04:15 (after the 03:30 VPS backup).
  Install: copy to ~/Library/LaunchAgents/, then launchctl bootstrap gui/$(id -u) ~/Library/LaunchAgents/com.2p.crew-backup-pull.plist
  Remove:  launchctl bootout gui/$(id -u)/com.2p.crew-backup-pull && rm ~/Library/LaunchAgents/com.2p.crew-backup-pull.plist
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.2p.crew-backup-pull</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/phannhatquang/crew-backups/bin/pull-backup.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key>
    <integer>4</integer>
    <key>Minute</key>
    <integer>15</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/phannhatquang/crew-backups/pull.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/phannhatquang/crew-backups/pull.log</string>
  <key>RunAtLoad</key>
  <false/>
</dict>
</plist>
